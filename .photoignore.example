# .photoignore: Exclude files from backup
#
# Patterns:
#  - *.jpg       Match by extension
#  - dirname/    Match directory (include trailing /)
#  - pattern*    Glob patterns supported (*, ?, [abc])
#  - # comment   Lines starting with # are comments

# Metadata
.claude/
_Manifest/

# Temporary files
*.tmp
*.cache
*.lock
*.swp
*~

# System files
Thumbs.db
.DS_Store

# IDE/Editor
.vscode/
.idea/
.swp

# Development
node_modules/
dist/
build/

# Project-specific (uncomment as needed)
# *.psd
# *.xcf
# .git/
