# Example .photoignore file
#
# This file controls which folders and files are excluded from backup scanning.
# Place a .photoignore file in any folder to exclude patterns from that folder
# and all subfolders (unless overridden by a subfolder's .photoignore).
#
# Format:
#  - One pattern per line
#  - Glob patterns supported (*, ?, [abc])
#  - Lines starting with # are comments
#  - Blank lines are ignored
#  - Patterns ending with / match directory names
#  - Patterns without / match file names

# Exclude Claude project metadata (if you have .claude folders)
.claude/

# Exclude photo-organizer's own manifest storage
_Manifest/

# Exclude temporary files
*.tmp
*.cache
*.lock

# Exclude system folders (if not handled by OS skip list)
.DS_Store
Thumbs.db

# Exclude editor/IDE metadata
.vscode/
.idea/
*.swp

# Exclude development artifacts
node_modules/
dist/
build/

# Exclude video editing projects (optional)
*.prproj
*.fcpxml
